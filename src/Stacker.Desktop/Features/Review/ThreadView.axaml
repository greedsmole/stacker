<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.ThreadView" x:Name="ThreadRoot">
 <UserControl.Styles>
  <Style Selector="ToggleButton:checked PathIcon.thread-chevron">
   <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Border.thread.expanded">
   <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </UserControl.Styles>
 <Border Classes="thread" Classes.expanded="{Binding #Disclosure.IsChecked}" BorderBrush="{DynamicResource DividerBrush}"
         CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,2">
  <StackPanel>
   <ToggleButton x:Name="Disclosure" IsChecked="False" Classes="quiet" MinHeight="26"
                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,3"
                 AutomationProperties.Name="{Binding Label}">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource StackerSpace8}">
     <PathIcon Classes="thread-chevron" Width="7" Height="10" Data="{StaticResource IconChevronRight}"
               VerticalAlignment="Center" RenderTransformOrigin="50%,50%"/>
     <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource StackerCaptionFontSize}" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
    </Grid>
   </ToggleButton>
   <StackPanel Spacing="10" Margin="14,5,14,10" IsVisible="{Binding #Disclosure.IsChecked}">
    <ItemsControl ItemsSource="{Binding Comments}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,4,0,12" Spacing="8">
        <StackPanel Spacing="2">
         <TextBlock Text="{Binding Author}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Author}"/>
         <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}"/>
        </StackPanel>
        <local:ReviewBodyView Body="{Binding DisplayBody}" OriginalCode="{Binding #ThreadRoot.OriginalCode}"/>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel ItemSpacing="4" LineSpacing="4">
     <Button Content="Reply" Click="ReplyClick" Classes="quiet compact"/>
     <StackPanel Orientation="Horizontal" IsVisible="{Binding CanResolve}">
      <Button Content="Resolve thread" IsVisible="{Binding !IsResolved}" Click="ResolveClick" Classes="quiet compact"/>
      <Button Content="Reopen thread" IsVisible="{Binding IsResolved}" Click="ResolveClick" Classes="quiet compact"/>
     </StackPanel>
     <Button Content="Go to code" Click="GoToClick" Classes="quiet compact" IsVisible="{Binding !IsOutdated}"/>
    </WrapPanel>
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
