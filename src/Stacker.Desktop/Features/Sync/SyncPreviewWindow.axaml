<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stacker.Desktop.SyncPreviewWindow" Title="Sync stack"
        Width="900" Height="680" MinWidth="700" MinHeight="560" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="dialog-heading" Padding="24,16">
      <StackPanel Spacing="{DynamicResource StackerSpace4}">
        <TextBlock x:Name="HeadingText" Classes="view-title" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubheadingText" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24" Spacing="{DynamicResource StackerSpace24}">
        <ItemsControl x:Name="BlockerList">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Classes="notice" Padding="12" Margin="0,0,0,8"><SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/></Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="ConflictPanel" Classes="notice" Padding="16" IsVisible="False">
          <StackPanel Spacing="{DynamicResource StackerSpace12}">
            <TextBlock x:Name="ConflictTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <ListBox x:Name="ConflictList" MaxHeight="150" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource StackerCaptionFontSize}"/>
            <WrapPanel ItemSpacing="{DynamicResource StackerSpace8}" LineSpacing="{DynamicResource StackerSpace8}">
              <Button x:Name="ResolveButton" Content="Resolve in editor" Click="ResolveClick" Classes="outline"/>
              <Button x:Name="StageButton" Content="Stage resolved files" Click="StageClick"/>
              <Button x:Name="ContinueButton" Content="Continue restack" Click="ContinueClick" Classes="outline"/>
            </WrapPanel>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Spacing="{DynamicResource StackerSpace12}">
                <StackPanel Spacing="{DynamicResource StackerSpace4}" IsVisible="{Binding #SkipButton.IsVisible}">
                  <TextBlock Text="Drop the current conflicting commit from the replay" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
                  <Button x:Name="SkipButton" Content="Skip current commit" Click="SkipClick" Classes="quiet" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource StackerSpace4}" IsVisible="{Binding #AbortButton.IsVisible}">
                  <TextBlock Text="Stop this operation and restore its starting state" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
                  <Button x:Name="AbortButton" Content="Abort and restore" Click="AbortClick" Classes="outline" HorizontalAlignment="Left"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="{DynamicResource StackerSpace24}">
         <StackPanel Spacing="{DynamicResource StackerSpace8}">
          <TextBlock Text="Restack plan" Classes="pane-title"/>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
            <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Padding="4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource StackerSpace12}" RowSpacing="{DynamicResource StackerSpace4}">
                    <Ellipse Classes="branch-node" Classes.current="{Binding NeedsRebase}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="112"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="code-meta" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <TextBlock Text="Each rewritten branch is backed up first. Conflicts pause the restack so you can resolve them in your editor." Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
          <CheckBox x:Name="PreserveMergesToggle" Content="Preserve merge commits" Click="PreserveClick"/>
          <StackPanel Spacing="{DynamicResource StackerSpace4}" IsVisible="{Binding #UndoButton.IsVisible}">
            <Button x:Name="UndoButton" Content="Undo last restack" Click="UndoClick" IsVisible="False" Classes="outline" HorizontalAlignment="Left"/>
            <TextBlock Text="Restore the branch tips saved before the last restack" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
          </StackPanel>
         </StackPanel>
         <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
          <StackPanel Spacing="{DynamicResource StackerSpace8}">
            <TextBlock Text="GitHub pull requests" Classes="pane-title"/>
            <TextBlock Text="Check which layers would create, update, or retarget a pull request." Classes="muted" TextWrapping="Wrap"/>
            <WrapPanel ItemSpacing="{DynamicResource StackerSpace8}" LineSpacing="{DynamicResource StackerSpace8}">
              <Button x:Name="CheckPrsButton" Content="Check pull requests" Click="CheckPrsClick" Classes="outline"/>
              <Button x:Name="PublishButton" Content="Publish pull requests" IsVisible="False" Click="PublishClick"/>
            </WrapPanel>
            <ListBox x:Name="PullRequestList" IsVisible="False" MaxHeight="200" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Padding="4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <StackPanel Spacing="{DynamicResource StackerSpace4}">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
         </Border>
        </Grid>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
          <StackPanel Spacing="{DynamicResource StackerSpace8}">
            <TextBlock Text="Working tree" Classes="pane-title"/>
            <TextBlock x:Name="WorkingTreeLabel" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
            <Button x:Name="StashButton" Content="Stash and restack" Click="StashClick" IsVisible="False" HorizontalAlignment="Left"/>
            <TextBlock Text="Tracked edits are stashed first. New files stay in the working tree." IsVisible="{Binding #StashButton.IsVisible}" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
            <StackPanel Spacing="{DynamicResource StackerSpace4}">
              <TextBlock Text="Saved changes" Classes="section-title" IsVisible="{Binding #StashInput.IsVisible}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StackerSpace8}">
                <ComboBox x:Name="StashInput" IsVisible="False" PlaceholderText="Choose saved changes" HorizontalAlignment="Stretch" AutomationProperties.Name="Saved changes">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" x:Name="RestoreButton" Content="Restore selected stash" Click="RestoreClick" IsVisible="False"/>
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource StackerSpace4}">
              <TextBlock Text="Switch branch" Classes="section-title"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StackerSpace8}">
                <ComboBox x:Name="BranchInput" HorizontalAlignment="Stretch" PlaceholderText="Choose a branch" AutomationProperties.Name="Branch to switch to"/>
                <Button Grid.Column="1" x:Name="SwitchButton" Content="Switch branch" Click="SwitchClick" Classes="outline"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Classes="dialog-footer" Padding="24,16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource StackerSpace8}">
        <ScrollViewer MaxHeight="64" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock x:Name="MessageLabel" TextWrapping="Wrap"/></ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource StackerSpace8}">
          <Button Content="Close" IsCancel="True" Click="CloseClick" HorizontalAlignment="Left" Classes="quiet"/>
          <Button Grid.Column="1" x:Name="PushButton" Content="Push the stack" Click="PushClick" IsVisible="False" Classes="outline"/>
          <Button Grid.Column="2" x:Name="RestackButton" Content="Restack (local)" Classes="primary" Click="RestackClick"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
