<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stacker.Desktop.StackEditorWindow" Title="Edit stack"
        Width="650" Height="680" MinWidth="520" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="dialog-heading" Padding="24,16">
      <StackPanel Spacing="{DynamicResource StackerSpace4}">
        <TextBlock Text="{Binding $parent[Window].Title}" Classes="view-title"/>
        <TextBlock Text="Arrange branches in dependency order, starting at the base." Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24" Spacing="{DynamicResource StackerSpace24}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource StackerSpace16}">
          <StackPanel Spacing="{DynamicResource StackerSpace4}">
            <TextBlock Text="Stack name" Classes="section-title"/>
            <TextBox x:Name="NameInput" AutomationProperties.Name="Stack name" Watermark="Authorization"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource StackerSpace4}">
            <TextBlock Text="Base branch" Classes="section-title"/>
            <ComboBox x:Name="BaseInput" AutomationProperties.Name="Stack base" HorizontalAlignment="Stretch"/>
            <TextBlock Text="The parent of the first layer" Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}"/>
          </StackPanel>
        </Grid>
        <StackPanel Spacing="{DynamicResource StackerSpace8}">
          <TextBlock Text="Layers" Classes="section-title"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StackerSpace8}">
            <ComboBox x:Name="BranchInput" AutomationProperties.Name="Branch to add" HorizontalAlignment="Stretch" PlaceholderText="Choose a branch to add"/>
            <Button Grid.Column="1" Content="Add layer" Click="AddClick" Classes="outline"/>
          </Grid>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
            <ListBox x:Name="BranchList" MinHeight="120" MaxHeight="220" Background="Transparent" BorderThickness="0" DragDrop.AllowDrop="True">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Background="Transparent" PointerPressed="LayerPointerPressed" Padding="2,2">
                  <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="⠿" Classes="muted" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Menlo,Consolas,monospace" FontSize="{DynamicResource StackerCaptionFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource StackerSpace4}">
              <Button Content="Move up" Click="UpClick" Classes="quiet compact"/>
              <Button Content="Move down" Click="DownClick" Classes="quiet compact"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Remove layer" Click="RemoveClick" Classes="quiet compact" ToolTip.Tip="Remove this layer from the definition; keep its Git branch"/>
          </Grid>
          <TextBlock Text="Drag a layer to reorder it, or select it and use Move up / Move down." Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" IsVisible="{Binding #DeleteButton.IsVisible}">
          <StackPanel Spacing="{DynamicResource StackerSpace8}">
            <TextBlock Text="Delete stack definition" Classes="section-title"/>
            <TextBlock Text="Remove this stack from Stacker. Its Git branches and commits are kept." Classes="muted" FontSize="{DynamicResource StackerCaptionFontSize}" TextWrapping="Wrap"/>
            <Button x:Name="DeleteButton" Content="Delete stack" Click="DeleteClick" HorizontalAlignment="Left" Classes="outline"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Classes="dialog-footer" Padding="24,16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource StackerSpace8}">
        <ScrollViewer MaxHeight="64" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock x:Name="ErrorLabel" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource StackerSpace8}">
          <Button Content="Cancel" IsCancel="True" Click="CancelClick" Classes="quiet"/>
          <Button Content="Save stack" IsDefault="True" Classes="primary" Click="SaveClick"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
