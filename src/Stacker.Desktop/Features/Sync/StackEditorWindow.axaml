<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.StackEditorWindow" Title="Edit stack" Width="650" Height="600" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="6"><TextBlock Text="Stack definition" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Order describes dependencies. Git branches stay unchanged." Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="80,*"><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="NameInput" AutomationProperties.Name="Stack name" Watermark="e.g. Authorization"/></Grid>
    <Grid Grid.Row="2" ColumnDefinitions="80,*"><TextBlock Text="Base" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="BaseInput" AutomationProperties.Name="Stack base" HorizontalAlignment="Stretch"/></Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox x:Name="BranchInput" AutomationProperties.Name="Branch to add" HorizontalAlignment="Stretch" PlaceholderText="Choose a branch to add"/><Button Grid.Column="1" Content="Add layer" Click="AddClick"/></Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <ListBox x:Name="BranchList" DragDrop.AllowDrop="True"><ListBox.ItemTemplate><DataTemplate><Border Background="Transparent" PointerPressed="LayerPointerPressed"><Grid ColumnDefinitions="24,*"><TextBlock Text="⠿" Opacity="0.5"/><TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel Grid.Column="1" Spacing="8"><Button Content="Move up" Click="UpClick"/><Button Content="Move down" Click="DownClick"/><Button Content="Remove" Click="RemoveClick"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="5" MaxHeight="80"><TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></ScrollViewer>
    <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Button x:Name="DeleteButton" Content="Delete stack" Click="DeleteClick" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="Cancel" IsCancel="True" Click="CancelClick"/><Button Grid.Column="2" Content="Save stack" Classes="primary" Click="SaveClick"/></Grid>
  </Grid>
</Window>
