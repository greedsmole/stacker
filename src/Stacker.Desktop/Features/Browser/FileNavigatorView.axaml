<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.FileNavigatorView"
             Background="{DynamicResource PanelBrush}">
 <UserControl.Resources>
  <DataTemplate x:Key="FileRowTemplate">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" ToolTip.Tip="{Binding DisplayPath}">
    <local:FileChangeBadge Change="{Binding Change}"/>
    <StackPanel Grid.Column="1" Spacing="2" Margin="0,3" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Directory}" IsVisible="{Binding HasDirectory}" Classes="code-meta" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <CheckBox Grid.Column="2" DataContext="{Binding ReviewRow}" IsVisible="{Binding HasReviewStatus, FallbackValue=False}"
              IsEnabled="{Binding CanChangeReview, FallbackValue=False}" IsChecked="{Binding IsReviewed, Mode=OneWay}"
              Click="FileReviewedClick" MinWidth="24" MinHeight="26" Padding="0" VerticalAlignment="Center"
              ToolTip.Tip="{Binding ReviewAction}" AutomationProperties.Name="{Binding ReviewAction}"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Padding="10,11,10,10" Classes="pane-heading">
   <StackPanel Spacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
     <TextBlock x:Name="FilesHeading" Text="Files" Classes="pane-title" VerticalAlignment="Center"/>
     <Border Grid.Column="1" Classes="segmented"><StackPanel Orientation="Horizontal" Spacing="2">
      <ToggleButton x:Name="ListMode" Content="List" IsChecked="True" Classes="quiet compact segment" Click="ListModeClick"/>
      <ToggleButton x:Name="FoldersMode" Content="Folders" Classes="quiet compact segment" Click="FoldersModeClick"/>
     </StackPanel></Border>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
     <TextBox x:Name="FilterBox" Watermark="Filter paths…" MinWidth="0" TextChanged="FilterChanged"
              AutomationProperties.Name="Filter changed files"/>
     <Button x:Name="ClearFilter" Grid.Column="1" Content="Clear" Classes="quiet compact" Click="ClearFilterClick"
             IsVisible="False" AutomationProperties.Name="Clear file filters"/>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
     <TextBlock x:Name="FileProgress" Classes="muted" FontSize="{StaticResource StackerCaptionFontSize}" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <ToggleButton x:Name="UnreviewedOnly" Grid.Column="1" Content="Unreviewed" Classes="quiet compact" Click="UnreviewedClick" IsVisible="False"/>
    </Grid>
    <ProgressBar x:Name="ReviewedProgress" Height="3" IsVisible="False" AutomationProperties.Name="Files reviewed"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1" Margin="6,8">
   <ListBox x:Name="FileList" Classes="file-list" ItemTemplate="{StaticResource FileRowTemplate}"
            SelectionChanged="FlatSelectionChanged" AutomationProperties.Name="Changed files"
            Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   <TreeView x:Name="FileTree" Classes="file-tree" SelectionChanged="TreeSelectionChanged" IsVisible="False"
             AutomationProperties.Name="Changed files by section or folder" AutoScrollToSelectedItem="True"
             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <TreeView.ItemTemplate>
     <TreeDataTemplate ItemsSource="{Binding Children}">
      <Grid>
       <Grid IsVisible="{Binding IsFolder}" ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding Name}">
        <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"
                  IsVisible="{Binding !IsComparisonSection}"/>
        <PathIcon Data="{StaticResource IconBranch}" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"
                  IsVisible="{Binding IsComparisonSection}"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="section-title" TextTrimming="CharacterEllipsis"/>
       </Grid>
       <ContentControl IsVisible="{Binding !IsFolder}" Content="{Binding Item}" ContentTemplate="{StaticResource FileRowTemplate}"/>
      </Grid>
     </TreeDataTemplate>
    </TreeView.ItemTemplate>
   </TreeView>
  </Grid>
  <TextBlock x:Name="FilesMessage" Grid.Row="2" Classes="muted" TextWrapping="Wrap" Margin="12,6,12,12"/>
 </Grid>
</UserControl>
