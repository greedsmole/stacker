<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.HistoryPanel"
             Background="{DynamicResource CanvasBrush}" FontSize="{DynamicResource StackerBodyFontSize}">
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Padding="14,8" Classes="pane-heading">
   <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource StackerSpace24}" IsEnabled="{Binding !IsBusy}">
     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
      <TextBlock Text="Layer" Classes="section-title" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                PlaceholderText="Select a layer" AutomationProperties.Name="History layer" MinWidth="0" HorizontalAlignment="Stretch"/>
      <Button Grid.Column="2" Content="Load layer" Command="{Binding LoadLayerCommand}" Classes="outline compact"/>
     </Grid>
     <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
      <TextBlock Text="Earlier version" Classes="section-title" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding PreviousVersion}"
                PlaceholderText="No earlier version" AutomationProperties.Name="Earlier version" MinWidth="0" HorizontalAlignment="Stretch"/>
      <Button Grid.Column="2" Content="Compare" Command="{Binding CompareVersionsCommand}" Classes="outline compact"/>
     </Grid>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
     <WrapPanel ItemSpacing="6" LineSpacing="6">
     <Button x:Name="HistoryFilesButton" Content="Browse files…" Classes="outline compact" IsEnabled="{Binding !IsBusy}">
      <Button.Flyout>
       <Flyout Placement="BottomEdgeAlignedLeft" Opening="OpenHistoryFiles">
        <local:FileNavigatorView Width="326" Height="360" KeyDown="HistoryFilesKeyDown" Tapped="HistoryFilesTapped"/>
       </Flyout>
      </Button.Flyout>
     </Button>
     <Button Content="View current changes" Command="{Binding ShowCurrentCommand}" Classes="quiet compact"/>
     <Button Content="Since my review" Command="{Binding SinceReviewedCommand}" Classes="quiet compact"
             ToolTip.Tip="Compare this file with the version you last marked reviewed"/>
     <Button x:Name="HistoryToolsButton" Content="History tools" Classes="quiet compact">
      <Button.Flyout>
       <Flyout Placement="BottomEdgeAlignedRight">
        <ScrollViewer x:Name="HistoryTools" Width="360" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Spacing="12">
          <StackPanel Spacing="2">
           <TextBlock Text="Compare and inspect" Classes="section-title" Margin="10,4,10,6"/>
           <Button Content="Check stack" Command="{Binding AnalyzeCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Button Content="Needs attention" Command="{Binding AttentionCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Button Content="Previous diff" Command="{Binding ShowPreviousCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Button Content="File through stack" Command="{Binding EvolutionCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Button Content="Undo reviewed" Command="{Binding UnmarkReviewedCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          </StackPanel>
          <Expander Header="Attention and blockers" HorizontalAlignment="Stretch">
           <StackPanel Spacing="6">
            <ListBox ItemsSource="{Binding Attention}" SelectedItem="{Binding SelectedAttention}" MaxHeight="160"/>
            <Button Content="Open selected queued file" Command="{Binding OpenAttentionCommand}"/>
            <Button Content="Clear queued blocker" Command="{Binding ClearQueuedBlockerCommand}"/>
            <TextBlock Text="Blocking question" Classes="section-title"/>
            <TextBox Text="{Binding ConcernText}" Watermark="What needs an answer?" TextWrapping="Wrap" AutomationProperties.Name="Blocking question"/>
            <Button Content="Flag blocker" Command="{Binding FlagBlockerCommand}"/>
            <Button Content="Clear blocker" Command="{Binding ClearBlockerCommand}"/>
           </StackPanel>
          </Expander>
          <Expander Header="Graph and maintenance" HorizontalAlignment="Stretch">
           <StackPanel Spacing="8">
            <TextBlock Text="{Binding Topology}" TextWrapping="Wrap"/>
            <TextBlock Text="Captured graph" Classes="section-title"/>
            <ComboBox ItemsSource="{Binding GraphHistory}" SelectedItem="{Binding HistoricalGraph}" HorizontalAlignment="Stretch" AutomationProperties.Name="Captured graph"/>
            <Button Content="Show historical graph" Command="{Binding ShowHistoricalGraphCommand}"/>
            <TextBlock Text="Dependency parent" Classes="section-title"/>
            <ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyParent}" HorizontalAlignment="Stretch" AutomationProperties.Name="Dependency parent"/>
            <TextBlock Text="Dependency child" Classes="section-title"/>
            <ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyChild}" HorizontalAlignment="Stretch" AutomationProperties.Name="Dependency child"/>
            <Button Content="Set parent" Command="{Binding SetDependencyCommand}"/>
            <TextBlock Text="Renamed local ref" Classes="section-title"/>
            <TextBox Text="{Binding NewLocalRef}" Watermark="refs/heads/branch" AutomationProperties.Name="Renamed local ref"/>
            <Button Content="Rebind local history" Command="{Binding RebindLocalRefCommand}"/>
            <TextBlock Text="Final-file line number" Classes="section-title"/>
            <TextBox Text="{Binding LineNumber}" Watermark="Line number" AutomationProperties.Name="Final-file line number"/>
            <Button Content="Find line origin" Command="{Binding TraceLineCommand}"/>
            <Button Content="Remove history pins" Command="{Binding ForgetHistoricalCodeCommand}"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </ScrollViewer>
       </Flyout>
      </Button.Flyout>
     </Button>
     </WrapPanel>
     <Button Grid.Column="1" Content="Mark file reviewed" Command="{Binding MarkReviewedCommand}" Classes="primary compact"
             ToolTip.Tip="Mark the selected file reviewed on the current layer version"/>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <ContentControl x:Name="HistoryDiff" Content="{Binding ActiveDocumentSection}" IsVisible="{Binding HasActiveDocumentSection}"
                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <ContentControl.ContentTemplate>
     <DataTemplate><local:DiffSectionView ShowFileNavigator="False"/></DataTemplate>
    </ContentControl.ContentTemplate>
   </ContentControl>
   <ScrollViewer IsVisible="{Binding !HasActiveDocumentSection}" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,32" Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
     <TextBlock Text="Choose a comparison" IsVisible="{Binding !HasPreview}" Classes="view-title"/>
     <TextBlock Text="{Binding EmptyDocumentMessage}" IsVisible="{Binding !HasPreview}" TextWrapping="Wrap" Classes="muted"/>
     <SelectableTextBlock Text="{Binding Preview}" IsVisible="{Binding HasPreview}" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Classes="dialog-footer">
   <Grid RowDefinitions="Auto,Auto">
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2"/>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="14,2">
     <ScrollViewer VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled" MaxHeight="56">
      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="code-meta" Margin="0,2"/>
     </ScrollViewer>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasActiveDocumentSection}">
      <TextBlock Text="{Binding SelectedFile.State}" ToolTip.Tip="{Binding SelectedFile.Label}" FontSize="{DynamicResource StackerCaptionFontSize}" Classes="muted" VerticalAlignment="Center"/>
      <Button Content="Details" IsVisible="{Binding HasPreview}" Classes="quiet compact">
       <Button.Flyout>
        <Flyout Placement="TopEdgeAlignedRight">
         <ScrollViewer Width="400" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap"/>
         </ScrollViewer>
        </Flyout>
       </Button.Flyout>
      </Button>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
