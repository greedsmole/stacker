<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.HistoryPanel" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="20,12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
   <StackPanel Spacing="4"><TextBlock Text="Review history" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Compare versions. Keep track of what you have reviewed." Classes="muted" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Content="Check stack" Command="{Binding AnalyzeCommand}" Classes="quiet"/><Button Content="Needs attention" Command="{Binding AttentionCommand}" Classes="quiet"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
   <StackPanel Spacing="4"><TextBlock Text="Layer" Classes="section-title"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><ComboBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" PlaceholderText="Select a layer" AutomationProperties.Name="History layer" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Load layer" Command="{Binding LoadLayerCommand}"/></Grid></StackPanel>
   <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Compare with" Classes="section-title"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding PreviousVersion}" PlaceholderText="No earlier version captured" AutomationProperties.Name="Earlier version" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Compare" Command="{Binding CompareVersionsCommand}"/></Grid></StackPanel>
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="220,16,*">
   <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
    <TextBlock Text="Files in this layer" Classes="section-title"/>
    <TextBlock IsVisible="{Binding !Files.Count}" Text="{Binding EmptyFilesMessage}" Classes="muted" TextWrapping="Wrap"/>
    <ListBox x:Name="ReviewFiles" Classes="file-list" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Expander Header="Compare and navigate" HorizontalAlignment="Stretch"><StackPanel Spacing="6">
     <Button Content="Since my review" Command="{Binding SinceReviewedCommand}"/><Button Content="Current diff" Command="{Binding ShowCurrentCommand}"/><Button Content="Previous diff" Command="{Binding ShowPreviousCommand}"/><Button Content="File through stack" Command="{Binding EvolutionCommand}"/><Button Content="Undo reviewed" Command="{Binding UnmarkReviewedCommand}"/>
    </StackPanel></Expander>
    <Expander Header="Attention and blockers" HorizontalAlignment="Stretch"><StackPanel Spacing="6"><ListBox ItemsSource="{Binding Attention}" SelectedItem="{Binding SelectedAttention}" MaxHeight="160"/><Button Content="Open queued file" Command="{Binding OpenAttentionCommand}"/><Button Content="Clear queued blocker" Command="{Binding ClearQueuedBlockerCommand}"/><TextBlock Text="Blocking question" Classes="section-title"/><TextBox Text="{Binding ConcernText}" Watermark="What needs an answer?" TextWrapping="Wrap"/><Button Content="Flag blocker" Command="{Binding FlagBlockerCommand}"/><Button Content="Clear blocker" Command="{Binding ClearBlockerCommand}"/></StackPanel></Expander>
    <Expander Header="Graph and maintenance" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><TextBlock Text="{Binding Topology}" TextWrapping="Wrap"/><TextBlock Text="Captured graph" Classes="section-title"/><ComboBox ItemsSource="{Binding GraphHistory}" SelectedItem="{Binding HistoricalGraph}"/><Button Content="Show historical graph" Command="{Binding ShowHistoricalGraphCommand}"/><TextBlock Text="Dependency parent" Classes="section-title"/><ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyParent}"/><TextBlock Text="Dependency child" Classes="section-title"/><ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyChild}"/><Button Content="Set parent" Command="{Binding SetDependencyCommand}"/><TextBlock Text="Renamed local ref" Classes="section-title"/><TextBox Text="{Binding NewLocalRef}" Watermark="refs/heads/branch"/><Button Content="Rebind local history" Command="{Binding RebindLocalRefCommand}"/><TextBlock Text="Final-file line number" Classes="section-title"/><TextBox Text="{Binding LineNumber}" Watermark="Line number"/><Button Content="Find line origin" Command="{Binding TraceLineCommand}"/><Button Content="Remove history pins" Command="{Binding ForgetHistoricalCodeCommand}"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4"><Button Content="Back" Command="{Binding BackCommand}" Classes="quiet"/><Button Grid.Column="1" Content="Forward" Command="{Binding ForwardCommand}" Classes="quiet"/><Button Grid.Column="3" Content="Mark reviewed" Command="{Binding MarkReviewedCommand}" Classes="primary"/></Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock IsVisible="{Binding !DocumentSections.Count}" Text="{Binding EmptyDocumentMessage}" TextWrapping="Wrap" Classes="muted" Margin="12,20"/><SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="8"/><ItemsControl ItemsSource="{Binding DocumentSections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="12" TextWrapping="Wrap"/><local:DiffSectionView Height="520"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Spacing="5"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2"/><ScrollViewer MaxHeight="64"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></ScrollViewer></StackPanel>
 </Grid>
</UserControl>
