<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.HistoryPanel" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="5"><TextBlock Text="Review history" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Captured versions · personal review progress · read-only analysis" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="Check stack" Command="{Binding AnalyzeCommand}"/><Button Grid.Column="2" Content="Needs attention" Command="{Binding AttentionCommand}"/></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" PlaceholderText="Layer" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Load layer" Command="{Binding LoadLayerCommand}"/><ComboBox Grid.Column="2" ItemsSource="{Binding Versions}" SelectedItem="{Binding PreviousVersion}" PlaceholderText="Previous observed version" HorizontalAlignment="Stretch"/><Button Grid.Column="3" Content="Compare versions" Command="{Binding CompareVersionsCommand}"/></Grid>
  <WrapPanel Grid.Row="2" Orientation="Horizontal"><Button Content="← Back" Command="{Binding BackCommand}" Margin="0,0,8,0"/><Button Content="Forward →" Command="{Binding ForwardCommand}" Margin="0,0,8,0"/><Button Content="Mark reviewed" Command="{Binding MarkReviewedCommand}" Margin="0,0,8,0"/><Button Content="Undo reviewed" Command="{Binding UnmarkReviewedCommand}" Margin="0,0,8,0"/><Button Content="Since my review" Command="{Binding SinceReviewedCommand}" Margin="0,0,8,0"/><Button Content="Current diff" Command="{Binding ShowCurrentCommand}" Margin="0,0,8,0"/><Button Content="Previous diff" Command="{Binding ShowPreviousCommand}" Margin="0,0,8,0"/><Button Content="File through stack" Command="{Binding EvolutionCommand}"/></WrapPanel>
  <Grid Grid.Row="3" ColumnDefinitions="310,12,*">
   <Grid RowDefinitions="*,Auto,Auto"><ListBox x:Name="ReviewFiles" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4,6"/></DataTemplate></ListBox.ItemTemplate></ListBox><Expander Grid.Row="1" Header="Attention and blockers"><StackPanel Spacing="6"><ListBox ItemsSource="{Binding Attention}" SelectedItem="{Binding SelectedAttention}" MaxHeight="160"/><Button Content="Open queued file" Command="{Binding OpenAttentionCommand}"/><Button Content="Clear queued blocker" Command="{Binding ClearQueuedBlockerCommand}"/><TextBox Text="{Binding ConcernText}" Watermark="Blocking question for selected file"/><Button Content="Flag blocker" Command="{Binding FlagBlockerCommand}"/><Button Content="Clear blocker" Command="{Binding ClearBlockerCommand}"/></StackPanel></Expander><Expander Grid.Row="2" Header="Graph and history"><ScrollViewer MaxHeight="300"><StackPanel Spacing="8"><TextBlock Text="{Binding Topology}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding GraphHistory}" SelectedItem="{Binding HistoricalGraph}"/><Button Content="Show historical graph" Command="{Binding ShowHistoricalGraphCommand}"/><TextBlock Text="Explicit dependency: parent → child"/><ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyParent}"/><ComboBox ItemsSource="{Binding GraphNodes}" SelectedItem="{Binding DependencyChild}"/><Button Content="Set parent" Command="{Binding SetDependencyCommand}"/><TextBox Text="{Binding NewLocalRef}" Watermark="Renamed local full ref"/><Button Content="Rebind selected local history" Command="{Binding RebindLocalRefCommand}"/><TextBox Text="{Binding LineNumber}" Watermark="Final-file line number"/><Button Content="Find line origin" Command="{Binding TraceLineCommand}"/><Button Content="Remove history pins" Command="{Binding ForgetHistoricalCodeCommand}"/></StackPanel></ScrollViewer></Expander></Grid>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel><SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="8"/><ItemsControl ItemsSource="{Binding DocumentSections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="12"/><local:DiffSectionView Height="520"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="4" Spacing="5"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</UserControl>
