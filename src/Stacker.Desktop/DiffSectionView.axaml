<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.DiffSectionView">
 <UserControl.Resources><local:LineBrushConverter x:Key="LineBrush"/></UserControl.Resources>
 <Grid x:Name="ContentGrid" ColumnDefinitions="230,1,*">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
   <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10"><TextBlock Text="Files" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="muted" FontSize="10"/></Grid>
   <TextBox Grid.Row="1" Text="{Binding Filter}" Watermark="Filter files…" Margin="0,0,0,10"/>
   <ListBox Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="4"><TextBlock Text="{Binding DisplayPath}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayPath}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding Stats}" FontSize="10"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}"/>
  <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">
   <Border Padding="16,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="4"><TextBlock Text="{Binding SelectedFile.DisplayPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedFile.Detail}" Classes="muted" FontSize="11"/></StackPanel>
     <Button Grid.Column="1" Content="Comment on file" Click="FileCommentClick" IsVisible="{Binding IsPrSnapshot}" Classes="quiet"/>
     <Button Grid.Column="2" Content="···" Classes="quiet" ToolTip.Tip="File actions"><Button.Flyout><MenuFlyout><MenuItem Header="Copy patch" Click="CopyClick"/><MenuItem Header="Review PR" Click="ReviewClick" IsVisible="{Binding HasPr}"/></MenuFlyout></Button.Flyout></Button>
    </Grid>
   </Border>
   <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2"/>
   <StackPanel Grid.Row="2" Margin="14,4" Spacing="4"><TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap"/><Button Content="Retry" Click="RetryClick" IsVisible="{Binding HasLoadError}" HorizontalAlignment="Left"/></StackPanel>
   <ScrollViewer Grid.Row="3" MaxHeight="180"><ItemsControl ItemsSource="{Binding FileThreads}" Margin="14,0"><ItemsControl.ItemTemplate><DataTemplate><local:ThreadView/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <ListBox x:Name="DiffLines" SelectionMode="Multiple" KeyDown="DiffKeyDown" Grid.Row="4" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Menlo,Consolas,monospace" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="23"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style><Style Selector="Button.line-add"><Setter Property="Opacity" Value="0"/><Setter Property="Padding" Value="2,0"/><Setter Property="MinHeight" Value="20"/></Style><Style Selector="ListBoxItem:pointerover Button.line-add"><Setter Property="Opacity" Value="1"/></Style><Style Selector="Button.line-add:focus"><Setter Property="Opacity" Value="1"/></Style></ListBox.Styles>
    <ListBox.ItemTemplate><DataTemplate>
     <Border Background="{Binding Kind, Converter={StaticResource LineBrush}}" MinHeight="23"><StackPanel>
      <Grid ColumnDefinitions="26,44,44,18,*" Margin="0,1">
       <Button Content="+" Classes="line-add" Click="AddLineClick" PointerPressed="AddLinePointerPressed" IsVisible="{Binding IsCode}" ToolTip.Tip="Comment on line (Shift-click for a range)" AutomationProperties.Name="Comment on line"/>
       <TextBlock Grid.Column="1" Text="{Binding OldLineNumber}" Opacity="0.45" HorizontalAlignment="Right" Margin="0,2,8,0" PointerPressed="LineNumberPressed"/>
       <TextBlock Grid.Column="2" Text="{Binding NewLineNumber}" Opacity="0.45" HorizontalAlignment="Right" Margin="0,2,8,0" PointerPressed="LineNumberPressed"/>
       <TextBlock Grid.Column="3" Text="{Binding Marker}" Opacity="0.6" Margin="0,2"/>
       <local:SyntaxText Grid.Column="4" Line="{Binding}" Margin="4,2,20,0"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding InlineThreads}" Margin="110,4,16,4" MaxWidth="650" HorizontalAlignment="Left" FontFamily="Inter"><ItemsControl.ItemTemplate><DataTemplate><local:ThreadView/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Drafts}" Margin="110,2,16,2" MaxWidth="650" HorizontalAlignment="Left" FontFamily="Inter"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="notice" Padding="10" Margin="0,3"><StackPanel Spacing="4"><TextBlock Text="Pending review" Classes="label"/><SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap"/><Button Content="Edit" Click="EditInlineDraftClick" Classes="quiet" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border IsVisible="{Binding HasEditor}" Margin="110,8,16,12" Padding="12" MaxWidth="650" MinWidth="260" HorizontalAlignment="Left" Background="{DynamicResource PanelBrush}" TextElement.FontFamily="Inter">
       <StackPanel DataContext="{Binding Editor}" Spacing="8" IsEnabled="{Binding CanEditDraft}"><TextBlock Text="{Binding SelectionLabel}" Classes="muted" TextWrapping="Wrap"/><TextBox Text="{Binding Composer}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MinWidth="260" Watermark="Leave a review comment…"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Add to review" Command="{Binding AddToDraftCommand}" Classes="primary"/><Button Content="Post now" Command="{Binding PostInlineCommand}" IsEnabled="{Binding CanPublish}" Classes="quiet"/><Button Content="Close" Click="CloseInlineClick" Classes="quiet"/></StackPanel></StackPanel>
      </Border>
     </StackPanel></Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
 </Grid>
</UserControl>
