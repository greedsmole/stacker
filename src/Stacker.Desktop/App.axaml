<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.App" Name="Stacker" RequestedThemeVariant="Dark">
 <Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SelectionBrush">#35443B</SolidColorBrush><SolidColorBrush x:Key="SelectionTextBrush">#F1F6EF</SolidColorBrush><SolidColorBrush x:Key="CanvasBrush">#191D1C</SolidColorBrush><SolidColorBrush x:Key="PanelBrush">#222725</SolidColorBrush><SolidColorBrush x:Key="DividerBrush">#3B4440</SolidColorBrush><SolidColorBrush x:Key="NoticeBrush">#2C3631</SolidColorBrush><SolidColorBrush x:Key="WarningBrush">#E5B76B</SolidColorBrush><SolidColorBrush x:Key="SuggestionAddedBrush">#193D2B</SolidColorBrush><SolidColorBrush x:Key="SuggestionRemovedBrush">#402626</SolidColorBrush></ResourceDictionary>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SelectionBrush">#DDE9DD</SolidColorBrush><SolidColorBrush x:Key="SelectionTextBrush">#203C2C</SolidColorBrush><SolidColorBrush x:Key="CanvasBrush">#FCFCF9</SolidColorBrush><SolidColorBrush x:Key="PanelBrush">#F0F2ED</SolidColorBrush><SolidColorBrush x:Key="DividerBrush">#D5DCD5</SolidColorBrush><SolidColorBrush x:Key="NoticeBrush">#E8EEE7</SolidColorBrush><SolidColorBrush x:Key="WarningBrush">#875816</SolidColorBrush><SolidColorBrush x:Key="SuggestionAddedBrush">#E4F5E9</SolidColorBrush><SolidColorBrush x:Key="SuggestionRemovedBrush">#FCE7E7</SolidColorBrush></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries></ResourceDictionary></Application.Resources>
 <Application.Styles>
  <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#5FA77B"/><ColorPaletteResources x:Key="Light" Accent="#286748"/></FluentTheme.Palettes></FluentTheme>
  <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource CanvasBrush}"/></Style>
  <Style Selector="Button, ToggleButton"><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style Selector="Button.quiet, ToggleButton.quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ToggleButton.quiet:checked"><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
  <Style Selector="ToggleButton.quiet:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="Button.line-add"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.8"/></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.8"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#286748"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.notice"><Setter Property="Background" Value="{DynamicResource NoticeBrush}"/><Setter Property="CornerRadius" Value="3"/></Style>
  <Style Selector="Border.selected"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="CornerRadius" Value="2"/></Style>
  <Style Selector="ListBox.file-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,8"/></Style>
  <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#20563B"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#19452F"/><Setter Property="Foreground" Value="White"/></Style>
 </Application.Styles>
</Application>
