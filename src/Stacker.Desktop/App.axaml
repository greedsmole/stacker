<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.App" Name="Stacker" RequestedThemeVariant="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Stacker/Design/FluentTokens.axaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme DensityStyle="Compact">
   <FluentTheme.Palettes>
    <ColorPaletteResources x:Key="Dark" Accent="#0F6CBD" RegionColor="#1F1F1F"/>
    <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" RegionColor="#FAFAFA"/>
   </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Stacker/Design/FluentControls.axaml"/>
 </Application.Styles>
</Application>
