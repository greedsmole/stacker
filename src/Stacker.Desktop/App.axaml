<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.App" Name="Stacker" RequestedThemeVariant="Dark">
 <Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="CanvasBrush">#191B20</SolidColorBrush><SolidColorBrush x:Key="PanelBrush">#202228</SolidColorBrush><SolidColorBrush x:Key="DividerBrush">#34363E</SolidColorBrush><SolidColorBrush x:Key="NoticeBrush">#303043</SolidColorBrush><SolidColorBrush x:Key="WarningBrush">#E5B76B</SolidColorBrush></ResourceDictionary>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="CanvasBrush">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="PanelBrush">#F6F7F9</SolidColorBrush><SolidColorBrush x:Key="DividerBrush">#E0E2E8</SolidColorBrush><SolidColorBrush x:Key="NoticeBrush">#EEF0FC</SolidColorBrush><SolidColorBrush x:Key="WarningBrush">#94621A</SolidColorBrush></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries></ResourceDictionary></Application.Resources>
 <Application.Styles>
  <FluentTheme/>
  <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource CanvasBrush}"/></Style>
  <Style Selector="Button, ToggleButton"><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style Selector="Button.quiet, ToggleButton.quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ToggleButton.quiet:checked"><Setter Property="Background" Value="#305B69CF"/></Style>
  <Style Selector="ToggleButton.quiet:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#305B69CF"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="Button.line-add"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.10"/></Transitions></Setter></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.6"/></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.55"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#606DE0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.notice"><Setter Property="Background" Value="{DynamicResource NoticeBrush}"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style Selector="Border.selected"><Setter Property="Background" Value="#285B69CF"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,8"/></Style>
 </Application.Styles>
</Application>
