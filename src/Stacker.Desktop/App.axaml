<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.App" Name="Stacker" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="12,7"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.65"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.65"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#526BEA"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,8"/></Style>
  </Application.Styles>
</Application>
