<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Stacker.Desktop" x:Class="Stacker.Desktop.MainWindow" Title="Stacker" Icon="avares://Stacker/Assets/Stacker.png" Width="1400" Height="880" MinWidth="1060" MinHeight="640" Background="{DynamicResource CanvasBrush}">
 <Window.Resources>
  <DataTemplate x:Key="StackGroupTemplate">
   <StackPanel Margin="0,0,0,20">
    <Border Classes.selected="{Binding IsSelected}" CornerRadius="3">
     <Grid ColumnDefinitions="26,*,28">
      <ToggleButton Content="⌄" IsChecked="{Binding IsExpanded}" IsVisible="{Binding IsStack}" Classes="quiet" Padding="4" ToolTip.Tip="Expand or collapse stack"/>
      <Button Grid.Column="1" Click="StackClick" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="quiet" Padding="4,8"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11"/></StackPanel></Button>
      <Button Grid.Column="2" Content="···" IsVisible="{Binding IsStack}" Classes="quiet" Padding="4" ToolTip.Tip="Stack actions"><Button.Flyout><MenuFlyout><MenuItem Header="Restack…" Click="RestackClick" IsVisible="{Binding !IsRemote}"/><MenuItem Header="Add layer…" Click="AddLayerClick" IsVisible="{Binding !IsRemote}"/><MenuItem Header="Commit…" Click="CommitClick" IsVisible="{Binding !IsRemote}"/><MenuItem Header="Undo last restack" Click="UndoRestackClick" IsVisible="{Binding UndoAvailable}"/><MenuItem Header="Edit stack" Click="EditGroupClick" IsVisible="{Binding !IsRemote}"/><MenuItem Header="Save as local stack" Click="SaveGroupClick" IsVisible="{Binding IsRemote}"/></MenuFlyout></Button.Flyout></Button>
     </Grid>
    </Border>
    <StackPanel IsVisible="{Binding ShowLayers}">
     <Button Content="Entire stack" Click="OverviewClick" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,2,0,0"/>
     <TextBlock Text="{Binding BaseLabel}" Classes="muted" FontSize="11" Margin="34,0,0,4"/>
     <ItemsControl ItemsSource="{Binding Layers}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Classes.selected="{Binding IsSelected}" CornerRadius="3" Margin="0,1"><Grid ColumnDefinitions="26,22,*" Margin="3,0">
       <CheckBox IsChecked="{Binding IsChecked}" Click="LayerChecked" MinWidth="22" ToolTip.Tip="Select layer for comparison"/>
       <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center" Classes="muted"/>
       <Button Grid.Column="2" Click="LayerClick" AutomationProperties.Name="{Binding Title}" PointerPressed="LayerPointerPressed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="quiet" Padding="2,7"><StackPanel Spacing="3"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Button>
      </Grid></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel>
  </DataTemplate>
 </Window.Resources>
 <Grid RowDefinitions="60,2,Auto,Auto,*,30">
  <Border Padding="16,6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
   <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
     <Image Source="avares://Stacker/Assets/Stacker.png" Width="30" Height="30" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
     <TextBlock Text="stacker" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <ToggleButton x:Name="StacksToggle" Click="ToggleStacksClick" IsChecked="True" IsVisible="{Binding IsChangesOpen}" Classes="quiet" Padding="5" ToolTip.Tip="Hide stacks" AutomationProperties.Name="Show stacks">
      <PathIcon Width="15" Height="15" Data="M 1,2 L 15,2 L 15,14 L 1,14 Z M 2,3 L 2,13 L 6,13 L 6,3 Z M 7,3 L 7,13 L 14,13 L 14,3 Z"/>
     </ToggleButton>
    </StackPanel>
    <Button x:Name="RepositoryButton" Grid.Column="1" Content="{Binding RepositoryTitle}" Classes="quiet" HorizontalAlignment="Left" MaxWidth="340" ToolTip.Tip="Switch repository"><Button.Flyout><Flyout><StackPanel Spacing="10" Width="320"><TextBlock Text="REPOSITORY" Classes="label"/><ComboBox x:Name="RecentBox" ItemsSource="{Binding RecentRepositories}" PlaceholderText="Recent repositories" HorizontalAlignment="Stretch" SelectionChanged="RecentChanged"/><Button x:Name="OpenFolderButton" Content="Open folder…" Click="OpenFolderClick"/><Button Content="Open demo" Click="OpenDemoClick"/><TextBox Text="{Binding RepositoryPath}" Watermark="Or enter a repository path" KeyDown="PathKeyDown"/></StackPanel></Flyout></Button.Flyout></Button>
    <ToggleButton Grid.Column="2" Content="Changes" IsChecked="{Binding IsChangesOpen, Mode=OneWay}" Click="ChangesTabClick" Classes="quiet"/>
    <ToggleButton Grid.Column="3" Content="Command log" IsChecked="{Binding IsGitLogOpen, Mode=OneWay}" Click="GitLogsTabClick" Classes="quiet"/>
    <Button Grid.Column="4" Content="Find" Click="FindClick" Classes="quiet" ToolTip.Tip="Find files (Cmd/Ctrl+P) or changed lines (Cmd/Ctrl+Shift+F)"/>
    <Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshAllCommand}" Classes="quiet" ToolTip.Tip="Refresh repository and GitHub" AutomationProperties.Name="Refresh"/>
    <Button Grid.Column="6" Content="Settings" Click="SettingsClick" Classes="quiet"/>
    <Button Grid.Column="7" Content="More" Classes="quiet" ToolTip.Tip="Settings and help"><Button.Flyout><MenuFlyout><MenuItem Header="Operations and recovery" Command="{Binding ShowOperationsCommand}"/><MenuItem Header="Export diagnostics…" Click="ExportDiagnosticsClick"/><MenuItem Header="Export workspace…" Click="ExportWorkspaceClick"/><MenuItem Header="Restore workspace copy…" Click="RestoreWorkspaceClick"/><MenuItem Header="Open restored workspace" Click="OpenRestoredWorkspaceClick" IsVisible="{Binding CanOpenRestoredWorkspace}"/><MenuItem Header="Locate moved repository…" Click="RelocateRepositoryClick"/><MenuItem Header="Settings" Click="SettingsClick"/><MenuItem Header="GitHub connection" Click="GitHubSettingsClick"/><MenuItem Header="Review history…" Click="HistoryClick"/><MenuItem Header="How comparisons work" Click="HelpClick"/></MenuFlyout></Button.Flyout></Button>
   </Grid>
  </Border>
  <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2"/>
  <Border Grid.Row="2" IsVisible="{Binding HasError}" Classes="notice" Padding="16,10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="Action could not be completed" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><ScrollViewer MaxHeight="80"><SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap"/></ScrollViewer></StackPanel><Button Grid.Column="1" Content="Dismiss" Click="DismissErrorClick" Classes="quiet" VerticalAlignment="Top"/></Grid></Border>
  <StackPanel Grid.Row="3" Spacing="2">
   <Border IsVisible="{Binding HasRecovery}" Classes="notice" Padding="16,8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="RestoreRecoveryButton" IsVisible="{Binding CanRestoreRecovery}" Content="Restore branches" Click="RestoreRecoveryClick"/><Button Grid.Column="2" x:Name="DismissRecoveryButton" Content="Dismiss" Click="DismissRecoveryClick"/></Grid></Border>
   <Border IsVisible="{Binding HasOperation}" Classes="notice" Padding="16,8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding OperationSummary}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="ResolveConflictsButton" Content="Resolve in editor" Click="ResolveConflictsClick"/><Button Grid.Column="2" Content="Review conflicts…" Click="ReviewConflictsClick"/></Grid></Border>
  </StackPanel>
  <Grid Grid.Row="4" x:Name="Workspace" IsVisible="{Binding IsChangesOpen}" ColumnDefinitions="260,1,*,Auto">
   <Grid x:Name="StacksPane" RowDefinitions="*,Auto" Background="{DynamicResource PanelBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12,20">
     <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,10"><TextBlock Text="Local stacks" Classes="section-title" VerticalAlignment="Center"/><Button Grid.Column="1" Content="+" Click="NewStackClick" IsEnabled="{Binding CanEdit}" Classes="quiet" ToolTip.Tip="Create stack"/></Grid>
     <ItemsControl ItemsSource="{Binding LocalGroups}" ItemTemplate="{StaticResource StackGroupTemplate}"/>
     <TextBlock Text="GitHub stacks" Classes="section-title" Margin="4,18,0,12"/>
     <ItemsControl ItemsSource="{Binding RemoteGroups}" ItemTemplate="{StaticResource StackGroupTemplate}"/>
     <TextBlock Text="Pull requests" IsVisible="{Binding HasOtherGroups}" Classes="label" Margin="4,18,0,12"/>
     <ItemsControl ItemsSource="{Binding OtherGroups}" ItemTemplate="{StaticResource StackGroupTemplate}"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="1" Padding="14,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"><StackPanel Spacing="6"><TextBlock Text="{Binding GitHubStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxHeight="90" ToolTip.Tip="{Binding GitHubStatus}"/><ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding GitHubBusy}"/></StackPanel></Border>
   </Grid>
   <GridSplitter x:Name="StacksSplitter" Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}"/>
   <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
    <Border Padding="22,18,22,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
     <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="{Binding ComparisonTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ComparisonTitle}"/>
      <TextBlock Grid.Row="1" Text="{Binding ComparisonDetail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ComparisonDetail}"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
       <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelectedLayer}"><ToggleButton Content="This layer" IsChecked="{Binding IsSingleLayer, Mode=OneWay}" Click="ThisLayerClick" Classes="quiet"/><ToggleButton Content="Through this layer" IsChecked="{Binding IsThroughLayer, Mode=OneWay}" Click="ThroughLayerClick" Classes="quiet"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Content="History" Click="HistoryClick" Classes="quiet"/><Button Content="Restack…" Click="RestackClick" IsVisible="{Binding CanRestackActiveStack}" Classes="quiet"/><Button Content="Discussion" Click="PrCommentsClick" IsVisible="{Binding HasPrDiscussion}" Classes="quiet"/><Button Content="{Binding ReviewLabel}" Click="ReviewPrClick" IsVisible="{Binding CanReview}" Classes="primary"/></StackPanel>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsSearchOpen}" Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"><StackPanel Spacing="8">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Find in this comparison" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Close" Click="CloseSearchClick" Classes="quiet"/></Grid>
     <Grid ColumnDefinitions="150,*,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="4"><TextBlock Text="Search in" Classes="section-title"/><ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope}" HorizontalAlignment="Stretch" AutomationProperties.Name="Search scope"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Query" Classes="section-title"/><TextBox x:Name="SearchBox" Text="{Binding SearchQuery}" Watermark="File name or changed text" KeyDown="SearchKeyDown" AutomationProperties.Name="Search query"/></StackPanel><CheckBox Grid.Column="2" Content="Regex" IsChecked="{Binding SearchRegex}" VerticalAlignment="Bottom"/><Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" Classes="primary" VerticalAlignment="Bottom"/></Grid>
     <TextBlock Text="{Binding SearchStatus}" Classes="muted" FontSize="11"/><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearchBusy}" Height="2"/>
     <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="190" SelectionChanged="SearchResultSelected" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4" Spacing="2"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Classes="muted" FontFamily="Menlo,Consolas,monospace" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></Border>
    <Border Grid.Row="2" IsVisible="{Binding HasPendingChanges}" Classes="notice" Padding="14,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="New changes available · your current view is preserved" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Update changes" Command="{Binding UpdateChangesCommand}" Classes="quiet"/></Grid></Border>
    <StackPanel Grid.Row="3" IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32" Spacing="12" MaxWidth="420"><TextBlock Text="Choose changes to review" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Classes="muted"/><WrapPanel><Button Content="Create stack" Click="NewStackClick" IsVisible="{Binding CanEdit}" Classes="primary" Margin="0,0,8,8"/><Button Content="Open repository" Click="OpenFolderClick" IsVisible="{Binding !CanEdit}" Classes="primary" Margin="0,0,8,8"/><Button Content="Open demo" Click="OpenDemoClick" Classes="quiet" Margin="0,0,8,8"/></WrapPanel></StackPanel>
    <StackPanel Grid.Row="3" IsVisible="{Binding ShowLoadingState}" Margin="32" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Loading workspace…" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Reading repository and comparison details." Classes="muted"/></StackPanel>
    <ScrollViewer Grid.Row="3" IsVisible="{Binding !HasNoSections}" x:Name="SectionScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
     <ToggleButton Content="{Binding Title}" IsChecked="{Binding IsExpanded}" IsVisible="{Binding ShowSectionHeader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="quiet" Margin="12,4"/>
     <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsContentVisible}"><TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource WarningBrush}" Margin="16,8" TextWrapping="Wrap"/><local:DiffSectionView Grid.Row="1" Height="{Binding PanelHeight}"/></Grid>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
   <Border x:Name="ReviewHost" Grid.Column="3" Width="390" HorizontalAlignment="Right" IsVisible="{Binding IsReviewOpen}" Background="{DynamicResource PanelBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerBrush}"><Grid RowDefinitions="44,*"><TextBlock Text="Pull request review" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Content="Close" Command="{Binding CloseReviewCommand}" HorizontalAlignment="Right" Classes="quiet"/><local:ReviewPanel Grid.Row="1" DataContext="{Binding ActiveReview}"/></Grid></Border>
   <Border Grid.Column="2" Grid.ColumnSpan="2" IsVisible="{Binding IsHistoryOpen}" Background="{DynamicResource CanvasBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
     <Border Padding="8,2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
       <Button Content="← Back to changes" Command="{Binding CloseHistoryCommand}" Classes="quiet"/>
       <TextBlock Grid.Column="1" Text="Review history" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
       <Button Grid.Column="2" Content="Back" Command="{Binding ActiveHistory.BackCommand}" Classes="quiet" ToolTip.Tip="Previous history view"/>
       <Button Grid.Column="3" Content="Forward" Command="{Binding ActiveHistory.ForwardCommand}" Classes="quiet" ToolTip.Tip="Next history view"/>
      </Grid>
     </Border>
     <Border Grid.Row="1" IsVisible="{Binding HasPendingChanges}" Classes="notice" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
       <TextBlock Text="New changes available" TextWrapping="Wrap" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="Update changes" Command="{Binding UpdateChangesCommand}" Classes="quiet"/>
      </Grid>
     </Border>
     <local:HistoryPanel Grid.Row="2" DataContext="{Binding ActiveHistory}"/>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="4" IsVisible="{Binding IsGitLogOpen}" RowDefinitions="Auto,*" Margin="18,12">
   <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
    <StackPanel Spacing="4"><TextBlock Text="Git and GitHub commands" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Current session · newest first" Classes="muted"/></StackPanel>
    <CheckBox Grid.Column="1" Content="GitHub only" IsChecked="{Binding GitHubLogsOnly}" VerticalAlignment="Top"/>
    <Button Grid.Column="2" Content="Saved operations" Command="{Binding ShowOperationsCommand}" Classes="quiet"/>
    <Button Grid.Column="3" Content="Copy" Click="CopyGitLogClick" Classes="quiet"/>
    <Button Grid.Column="4" Content="Clear" Command="{Binding ClearGitLogCommand}" Classes="quiet"/>
   </Grid>
   <TextBlock Grid.Row="1" Text="No commands to show." Classes="muted" IsVisible="{Binding !VisibleGitLogEntries.Count}" Margin="10"/>
   <ListBox Grid.Row="1" ItemsSource="{Binding VisibleGitLogEntries}" IsVisible="{Binding !!VisibleGitLogEntries.Count}" Background="Transparent" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
     <StackPanel Spacing="4">
      <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" FontSize="11"/>
      <TextBlock Text="{Binding WorkingDirectory}" IsVisible="{Binding !!WorkingDirectory}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
      <SelectableTextBlock Text="{Binding Detail}" IsVisible="{Binding !!Detail}" TextWrapping="Wrap" FontSize="11"/>
     </StackPanel>
    </Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Border Grid.Row="4" IsVisible="{Binding IsOperationsOpen}" Background="{DynamicResource CanvasBrush}" Padding="18"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Operations and recovery" FontSize="22"/><TextBlock Text="Saved Git and GitHub write attempts for this workspace." TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Close" Command="{Binding CloseOperationsCommand}"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding OperationItems}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8" Spacing="5"><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding OperationId}" Classes="muted"/><ItemsControl ItemsSource="{Binding Effects}"><ItemsControl.ItemTemplate><DataTemplate><SelectableTextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
  <Border Grid.Row="5" Padding="14,5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProductVersion}" FontSize="11" Classes="muted"/></Grid></Border>
 </Grid>
</Window>
