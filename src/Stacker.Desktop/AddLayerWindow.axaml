<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stacker.Desktop.AddLayerWindow" Title="Add layer" Width="600" Height="420" MinWidth="500" MinHeight="360" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <StackPanel Spacing="6">
      <TextBlock Text="New layer" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="StackLabel" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="Stacker creates the branch, checks it out and appends it to this stack. Your commits, and committing the updated .stackpr.yml, stay with you." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="110,*"><TextBlock Text="Branch name" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="NameInput" Watermark="e.g. feature/session-api"/></Grid>
    <Grid Grid.Row="2" ColumnDefinitions="110,*"><TextBlock Text="Start from" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="StartInput" HorizontalAlignment="Stretch"/></Grid>
    <TextBlock Grid.Row="4" x:Name="ErrorLabel" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Content="Cancel" Click="CancelClick" HorizontalAlignment="Left"/>
      <Button Grid.Column="2" x:Name="CreateButton" Content="Create layer" Classes="primary" Click="CreateClick"/>
    </Grid>
  </Grid>
</Window>
