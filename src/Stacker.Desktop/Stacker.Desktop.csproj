<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Stacker</AssemblyName>
    <!-- Single source of truth for the product version; scripts/package.py reads it and the status bar displays it. -->
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Stacker.Core/Stacker.Core.csproj" />
    <ProjectReference Include="../Stacker.Infrastructure/Stacker.Infrastructure.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
</Project>
